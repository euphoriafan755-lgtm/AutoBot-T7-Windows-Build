{
  "geode": "5.10.1",
  "gd": {
    "win": "2.2081"
  },
  "id": "thiago7tv.autobot-t7",
  "name": "AutoBot T7",
  "version": "0.2.0",
  "developer": "Thiago7TV",
  "description": "Cold reachability solver with real Geometry Dash verification, repair/re-anchor, and deterministic physics-tick input replay.",
  "settings": {
    "key-overlay": {
      "type": "keybind",
      "name": "Hide the overlay",
      "description": "Refused while solving; the bot status remains visible.",
      "default": "F1"
    },
    "key-pause": {
      "type": "keybind",
      "name": "Pause / resume",
      "default": "F2"
    },
    "key-step1": {
      "type": "keybind",
      "name": "Step one substep",
      "default": "F3"
    },
    "key-step10": {
      "type": "keybind",
      "name": "Step ten substeps",
      "default": "F4"
    },
    "key-render": {
      "type": "keybind",
      "name": "Rendering on / off",
      "default": "F5"
    },
    "key-hitboxes": {
      "type": "keybind",
      "name": "Hitboxes: off / on / only",
      "default": "F6"
    },
    "key-replay": {
      "type": "keybind",
      "name": "Replay from the start",
      "default": "F7"
    },
    "key-quit": {
      "type": "keybind",
      "name": "Quit to the level screen",
      "default": "F9"
    },
    "key-itermap": {
      "type": "keybind",
      "name": "Iteration map",
      "default": "F10"
    },
    "key-faster": {
      "type": "keybind",
      "name": "Spectating speed up",
      "default": "Up"
    },
    "key-slower": {
      "type": "keybind",
      "name": "Spectating speed down",
      "default": "Down"
    },
    "key-seek-back": {
      "type": "keybind",
      "name": "Seek back / frame step",
      "default": "Left"
    },
    "key-seek-forward": {
      "type": "keybind",
      "name": "Seek forward / frame step",
      "default": "Right"
    }
  }
}
